<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nexus_personal_api_keys.xml" />
        <exclude domain="sharedpref" path="nexus_encrypted_api_keys.xml" />
        <exclude domain="sharedpref" path="nexus_model_selection_mirror.xml" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nexus_personal_api_keys.xml" />
        <exclude domain="sharedpref" path="nexus_encrypted_api_keys.xml" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
