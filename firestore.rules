// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId} (NexusUserSettings)
// Fields:
//   - userId: string (required, immutable, matches auth.uid)
//   - provider: string (required, in ['gemini', 'anthropic', 'openai', 'fable', 'local'])
//   - selectedModel: string (required, 1..120 chars)
//   - maxTokens: int (required, 256..64000)
//   - maxSteps: int (required, 1..12)
//   - timeoutSec: int (required, 1..120)
//   - agentPersona: string (required, 1..2000 chars)
//   - activeSessionId: string (required, <= 128 chars)
//   - inputHistory: list<string> (required, <= 100 items)
//   - displayName, avatarDataUri, fontSize, responseStyle, personaPreset,
//     customPersonasJson, aboutUser, responsePreference, enableForNewChats,
//     skillsJson, skillsTokenBudget, recentWorkspaces: optional profile/personalization fields
//   - createdAt: timestamp (required, immutable, <= request.time)
//   - updatedAt: timestamp (required, <= request.time)
//
// Collection: users/{userId}/sessions/{sessionId} (NexusSession)
// Fields:
//   - userId: string (required, immutable, matches auth.uid)
//   - title: string (required, 1..120 chars)
//   - status: string (required, in ['idle', 'stream', 'wait', 'exec'])
//   - cwd: string (required, 1..512 chars)
//   - commandsCount: int (required, 0..100000)
//   - redactionsCount: int (required, 0..100000)
//   - provider: string (required, 1..40 chars)
//   - model: string (required, 1..120 chars)
//   - projectSlug: string (optional, <= 64 chars, slug pattern)
//   - storageLocation: string (optional, in ['shared_storage', 'termux_home_mirrored', 'temp_scratch'])
//   - createdAt: timestamp (required, immutable, <= request.time)
//   - updatedAt: timestamp (required, <= request.time)
//
// Collection: users/{userId}/sessions/{sessionId}/entries/{entryId} (TranscriptEntry)
// Fields:
//   - userId: string (required, immutable, matches auth.uid)
//   - sessionId: string (required, immutable, matches sessionId)
//   - type: string (required, immutable, in ['user', 'agent', 'command', 'output', 'notice', 'analysis'])
//   - text: string (required, <= 32000 chars)
//   - command: string (required, <= 4000 chars)
//   - reason: string (required, <= 1000 chars)
//   - commandStatus: string (required, in ['', 'pending', 'approved', 'denied', 'cancelled'])
//   - isRisky: bool (required)
//   - timeoutSec: int (required, 0..600)
//   - cwd: string (required, <= 512 chars)
//   - exitCode: int (required, -999..999)
//   - output: string (required, <= 32000 chars)
//   - redactions: int (required, 0..100000)
//   - noticeKind: string (required, <= 64 chars)
//   - sequence: int (required, immutable, 0..1000000)
//   - title: string (optional, <= 120 chars) - sanitized plain-language step title
//   - reasoningText: string (optional, <= 10000 chars) - redacted reasoning trace
//   - thinkingDurationSec: int (optional, 0..86400) - thinking duration in seconds
//   - jobId: string (optional, <= 128 chars) - background job identifier
//   - createdAt: timestamp (required, immutable, <= request.time)
//   - updatedAt: timestamp (required, <= request.time)
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // Validation Helper 1: NexusUserSettings
    function isValidNexusUserSettings(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.provider is string && data.provider in ['gemini', 'anthropic', 'openai', 'fable', 'local'] &&
             data.selectedModel is string && data.selectedModel.size() >= 1 && data.selectedModel.size() <= 120 &&
             data.maxTokens is int && data.maxTokens >= 256 && data.maxTokens <= 64000 &&
             data.maxSteps is int && data.maxSteps >= 1 && data.maxSteps <= 12 &&
             data.timeoutSec is int && data.timeoutSec >= 1 && data.timeoutSec <= 120 &&
             data.agentPersona is string && data.agentPersona.size() >= 1 && data.agentPersona.size() <= 2000 &&
             data.activeSessionId is string && data.activeSessionId.size() <= 128 &&
             data.inputHistory is list && data.inputHistory.size() <= 100 &&
             (data.inputHistory.size() == 0 || (data.inputHistory[0] is string && data.inputHistory[0].size() <= 2000)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80)) &&
             (!('avatarDataUri' in data) || (data.avatarDataUri is string && data.avatarDataUri.size() <= 350000)) &&
             (!('fontSize' in data) || (data.fontSize is string && data.fontSize in ['small', 'default', 'large'])) &&
             (!('responseStyle' in data) || (data.responseStyle is string && data.responseStyle in ['concise', 'balanced', 'detailed', 'technical'])) &&
             (!('personaPreset' in data) || (data.personaPreset is string && data.personaPreset.size() <= 64)) &&
             (!('customPersonasJson' in data) || (data.customPersonasJson is string && data.customPersonasJson.size() <= 50000)) &&
             (!('aboutUser' in data) || (data.aboutUser is string && data.aboutUser.size() <= 1500)) &&
             (!('responsePreference' in data) || (data.responsePreference is string && data.responsePreference.size() <= 1500)) &&
             (!('enableForNewChats' in data) || (data.enableForNewChats is bool)) &&
             (!('skillsJson' in data) || (data.skillsJson is string && data.skillsJson.size() <= 100000)) &&
             (!('skillsTokenBudget' in data) || (data.skillsTokenBudget is int && data.skillsTokenBudget >= 500 && data.skillsTokenBudget <= 6000)) &&
             (!('recentWorkspaces' in data) || (data.recentWorkspaces is list && data.recentWorkspaces.size() <= 5)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Helper 2: NexusSession
    function isValidNexusSession(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.status is string && data.status in ['idle', 'stream', 'wait', 'exec'] &&
             data.cwd is string && data.cwd.size() >= 1 && data.cwd.size() <= 512 &&
             data.commandsCount is int && data.commandsCount >= 0 && data.commandsCount <= 100000 &&
             data.redactionsCount is int && data.redactionsCount >= 0 && data.redactionsCount <= 100000 &&
             data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 40 &&
             data.model is string && data.model.size() >= 1 && data.model.size() <= 120 &&
             (!('projectSlug' in data) || (data.projectSlug is string && data.projectSlug.size() <= 64 && (data.projectSlug == '' || data.projectSlug.matches('^[a-z0-9\\-]+$')))) &&
             (!('storageLocation' in data) || (data.storageLocation is string && data.storageLocation in ['shared_storage', 'termux_home_mirrored', 'temp_scratch'])) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Helper 3: TranscriptEntry
    function isValidEntry(data, userId, sessionId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.sessionId is string && data.sessionId == sessionId &&
             data.type is string && data.type in ['user', 'agent', 'command', 'output', 'notice', 'analysis'] &&
             isOptionalString(data, 'text', 32000) &&
             isOptionalString(data, 'command', 4000) &&
             isOptionalString(data, 'reason', 1000) &&
             data.commandStatus is string && data.commandStatus in ['', 'pending', 'approved', 'denied', 'cancelled'] &&
             data.isRisky is bool &&
             data.timeoutSec is int && data.timeoutSec >= 0 && data.timeoutSec <= 600 &&
             isOptionalString(data, 'cwd', 512) &&
             data.exitCode is int && data.exitCode >= -999 && data.exitCode <= 999 &&
             isOptionalString(data, 'output', 32000) &&
             data.redactions is int && data.redactions >= 0 && data.redactions <= 100000 &&
             isOptionalString(data, 'noticeKind', 64) &&
             data.sequence is int && data.sequence >= 0 && data.sequence <= 1000000 &&
             isOptionalString(data, 'title', 120) &&
             isOptionalString(data, 'reasoningText', 10000) &&
             (!('thinkingDurationSec' in data) || (data.thinkingDurationSec is int && data.thinkingDurationSec >= 0 && data.thinkingDurationSec <= 86400)) &&
             isOptionalString(data, 'jobId', 128) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTranscriptEntry(data, sessionId) {
      return isValidEntry(data, request.auth.uid, sessionId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'provider', 'selectedModel', 'maxTokens', 'maxSteps',
                         'timeoutSec', 'agentPersona', 'activeSessionId', 'inputHistory',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'provider', 'selectedModel', 'maxTokens', 'maxSteps',
                         'timeoutSec', 'agentPersona', 'activeSessionId', 'inputHistory',
                         'displayName', 'avatarDataUri', 'fontSize', 'responseStyle',
                         'personaPreset', 'customPersonasJson', 'aboutUser', 'responsePreference',
                         'enableForNewChats', 'skillsJson', 'skillsTokenBudget', 'recentWorkspaces',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidNexusUserSettings(incoming());

      allow update: if isOwner(userId) &&
                       isValidNexusUserSettings(incoming()) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'provider', 'selectedModel', 'maxTokens', 'maxSteps',
                         'timeoutSec', 'agentPersona', 'activeSessionId', 'inputHistory',
                         'displayName', 'avatarDataUri', 'fontSize', 'responseStyle',
                         'personaPreset', 'customPersonasJson', 'aboutUser', 'responsePreference',
                         'enableForNewChats', 'skillsJson', 'skillsTokenBudget', 'recentWorkspaces',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'status', 'cwd', 'commandsCount',
                           'redactionsCount', 'provider', 'model', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'status', 'cwd', 'commandsCount',
                           'redactionsCount', 'provider', 'model', 'projectSlug', 'storageLocation',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidNexusSession(incoming());

        allow update: if isOwner(userId) &&
                         isValidNexusSession(incoming()) &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'status', 'cwd', 'commandsCount',
                           'redactionsCount', 'provider', 'model', 'projectSlug', 'storageLocation',
                           'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);

        match /entries/{entryId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidId(entryId);
          allow list: if isOwner(userId) && existing().userId == request.auth.uid;

          allow create: if isOwner(userId) &&
                           isValidId(userId) &&
                           isValidId(sessionId) &&
                           isValidId(entryId) &&
                           incoming().keys().hasAll([
                             'userId', 'sessionId', 'type', 'text', 'command', 'reason',
                             'commandStatus', 'isRisky', 'timeoutSec', 'cwd', 'exitCode',
                             'output', 'redactions', 'noticeKind', 'sequence', 'createdAt', 'updatedAt'
                           ]) &&
                           incoming().keys().hasOnly([
                             'userId', 'sessionId', 'type', 'text', 'command', 'reason',
                             'commandStatus', 'isRisky', 'timeoutSec', 'cwd', 'exitCode',
                             'output', 'redactions', 'noticeKind', 'sequence',
                             'title', 'reasoningText', 'thinkingDurationSec', 'jobId',
                             'createdAt', 'updatedAt'
                           ]) &&
                           isValidEntry(incoming(), userId, sessionId);

          allow update: if isOwner(userId) &&
                           isValidEntry(incoming(), userId, sessionId) &&
                           isValidId(userId) &&
                           isValidId(sessionId) &&
                           isValidId(entryId) &&
                           incoming().userId == existing().userId &&
                           incoming().sessionId == existing().sessionId &&
                           incoming().type == existing().type &&
                           incoming().sequence == existing().sequence &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'text', 'commandStatus', 'cwd', 'exitCode', 'output', 'redactions',
                             'title', 'reasoningText', 'thinkingDurationSec', 'jobId', 'updatedAt'
                           ]);

          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidId(entryId);
        }
      }
    }
  }
}
